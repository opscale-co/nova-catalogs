{
    "include": [
        "src",
        "tests",
        "workbench/app"
    ],
    "exclude": [
        "tests/fixtures"
    ],
    "scripts": {
        "lint": {
            "phpstan": ["vendor/bin/phpstan", "analyse", "--no-progress", "--memory-limit=1G"]
        },
        "fix": {
            "phpstan": false
        }
    },
    "processTimeout": 300
}
